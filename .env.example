# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Where to find Milvus. Leave unset for the embedded Milvus Lite file (hybrid_rag.db).
# For Milvus Standalone started with docker-compose.yml, when running the app on the host:
# MILVUS_ADDRESS=http://localhost:19530
# MILVUS_TOKEN=root:Milvus     # only if you enabled auth on the server

# RERANK=0 disables the Gemini re-ranker
